# Server Configuration
PORT=3001
NODE_ENV=development

# Google Sheets (Database)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Alternative: Use file path instead of inline JSON
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_FILE=./credentials/service-account.json

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Or use Resend's test email: onboarding@resend.dev

# Frontend URL (for email links)
REACT_APP_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: PostgreSQL (for future migration)
# DATABASE_URL=postgresql://localhost:5432/sportsraiser
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sportsraiser
# DB_USER=postgres
# DB_PASSWORD=password

# Optional: Redis (for caching)
# REDIS_URL=redis://localhost:6379

# Optional: PayPal Integration
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_WEBHOOK_ID=your_webhook_id
# PAYPAL_MODE=sandbox

# Optional: Twilio SMS
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Optional: AWS S3 (for file uploads)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
