{
  "name": "sportsraiser-platform",
  "version": "1.0.0",
  "description": "Complete SportsRaiser platform with RBAC, dashboards, and multi-role support",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "cross-env GENERATE_SOURCEMAP=false react-scripts start",
    "start:fast": "cross-env FAST_REFRESH=true GENERATE_SOURCEMAP=false react-scripts start",
    "start:analyze": "cross-env ANALYZE=true react-scripts start",
    "build": "react-scripts build",
    "build:analyze": "cross-env ANALYZE=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx --fix",
    "lint:check": "eslint src --ext .js,.jsx",
    "format": "prettier --write src/**/*.{js,jsx,json,css,md}",
    "clean": "rimraf build node_modules/.cache",
    "precommit": "npm run lint:check && npm run format"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vercel/kv": "^1.0.1",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "resend": "^3.0.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "prettier": "^3.1.0",
    "react-refresh": "^0.14.0",
    "rimraf": "^5.0.5",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^4.9.5",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
